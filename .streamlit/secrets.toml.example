# Copy to .streamlit/secrets.toml locally, or paste in Streamlit Cloud: App settings -> Secrets
GOOGLE_API_KEY = "your_google_api_key_here"
TAVILY_API_KEY = "your_tavily_api_key_here"

LANGSMITH_API_KEY = "your_langsmith_api_key_here"
LANGSMITH_PROJECT = "workout-planner"
# EU accounts are detected automatically; or set it explicitly:
# LANGSMITH_ENDPOINT = "https://eu.api.smith.langchain.com"
# Org-scoped keys also need:
# LANGSMITH_WORKSPACE_ID = "..."
